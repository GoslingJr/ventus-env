+        ("gpu-output", "Write the accelerator vector as vertex/value pairs", cxxopts::value<std::string>());
     cxxopts::ParseResult              args;
     int                               ret;
 
@@ -49,7 +100,12 @@ int main(int argc, const char* const* argv) {
 
