 #include <spla.hpp>
 
+#include <sstream>
+
+
+namespace {
+    struct WeightedGraph {
+        unsigned n = 0;
+        std::vector<unsigned> row, col;
+        std::vector<float> weights;
+
+        void add(unsigned i, unsigned j, float w) {
+            row.push_back(i);
+            col.push_back(j);
+            weights.push_back(w);
+        }
+    };
+
+    WeightedGraph read_weighted_graph(const std::string& path) {
+        std::ifstream input(path);
+        std::string line;
+        std::getline(input, line);
+        std::istringstream header(line);
+        std::string banner, object, format, field, symmetry;
+        header >> banner >> object >> format >> field >> symmetry;
+        if (banner != "%%MatrixMarket" || object != "matrix" || format != "coordinate" ||
+            field != "real" || symmetry != "symmetric") {
+            throw std::runtime_error("--matrix-weights requires a real symmetric Matrix Market file");
+        }
+        while (std::getline(input, line) && (line.empty() || line.front() == '%')) {}
+        std::istringstream shape(line);
+        WeightedGraph graph;
+        unsigned cols;
+        std::size_t count;
+        if (!(shape >> graph.n >> cols >> count) || graph.n != cols || graph.n == 0) {
+            throw std::runtime_error("Invalid graph dimensions");
+        }
+        for (std::size_t k = 0; k < count; ++k) {
+            unsigned i, j;
+            float w;
+            if (!(input >> i >> j >> w) || !i || !j || i > graph.n || j > graph.n ||
+                !std::isfinite(w) || w < 0) {
+                throw std::runtime_error("Invalid weighted edge");
+            }
+            graph.add(i - 1, j - 1, w);
+            if (i != j) graph.add(j - 1, i - 1, w);
+        }
+        return graph;
+    }
+}
 
 int main(int argc, const char* const* argv) {
     std::shared_ptr<cxxopts::Options> options = make_options("sssp", "sssp (single-source shortest path) algorithm with spla library");
+    options->add_options()
