+inline void write_float_vector(const std::string& path, const spla::ref_ptr<spla::Vector>& values) {
+    std::ofstream out;
+    out.exceptions(std::ios::failbit | std::ios::badbit);
+    out.open(path);
+    out.precision(std::numeric_limits<float>::max_digits10);
